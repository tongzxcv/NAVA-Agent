    "@lnwjud/capabilities": "workspace:*",
    "@lnwjud/domain": "workspace:*",
    "@lnwjud/extensions": "workspace:*",
    "@lnwjud/permissions": "workspace:*",
    "@lnwjud/search": "workspace:*",
    "@lnwjud/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "scripts": {
    "test": "pnpm --filter @lnwjud/domain build && pnpm --filter @lnwjud/capabilities build && pnpm --filter @lnwjud/extensions build && pnpm build && vitest run",
