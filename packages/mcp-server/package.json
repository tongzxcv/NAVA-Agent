{
  "name": "@lnwjud/mcp-server",
  "version": "4.12.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@lnwjud/application": "workspace:*",
