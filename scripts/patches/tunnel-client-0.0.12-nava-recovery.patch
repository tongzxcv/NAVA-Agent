diff --git a/pkg/dispatcher/path_health.go b/pkg/dispatcher/path_health.go
new file mode 100644
index 0000000..2969125e
--- /dev/null
+++ b/pkg/dispatcher/path_health.go
@@ -0,0 +1,86 @@
+package dispatcher
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/google/uuid"
+	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
+	dispatcherinternal "github.com/openai/tunnel-client/pkg/dispatcher/internal"
+	"github.com/openai/tunnel-client/pkg/httpguard"
+	"github.com/openai/tunnel-client/pkg/mcpclient"
+	"github.com/openai/tunnel-client/pkg/runtimeconfig"
+	"github.com/openai/tunnel-client/pkg/types"
+	"go.uber.org/fx"
+	"net/http"
+	"time"
+)
+
+type pathHealthParams struct {
+	fx.In
+	Mux      *http.ServeMux `name:"admin_mux"`
+	Bindings map[types.Channel]dispatcherinternal.ChannelBinding
+	Config   *runtimeconfig.MCPConfig
+}
+
+// Probe the same serialized connection as connector calls, never a second reader.
+func registerPathHealth(p pathHealthParams) {
+	httpguard.NewGuardedMux(p.Mux, false, "loopback only").HandleFunc("/api/mcp-health", func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		reply := func(code int, state string) {
+			w.WriteHeader(code)
+			_ = json.NewEncoder(w).Encode(map[string]string{"state": state})
+		}
+		if r.Method != http.MethodGet {
+			reply(405, "unavailable")
+			return
+		}
+		binding := p.Config.MainChannelBinding()
+		transport := p.Bindings[types.DefaultChannel].Transport
+		if binding == nil || binding.TransportKind != runtimeconfig.MCPTransportStdio || transport == nil {
+			reply(503, "unavailable")
+			return
+		}
+		// Waiting behind a legitimate tool is busy, not proof of a broken child.
+		acquireCtx, cancelAcquire := context.WithTimeout(r.Context(), 200*time.Millisecond)
+		conn, err := transport.Connect(mcpclient.ContextWithResponseDeadlineEnforcement(acquireCtx))
+		cancelAcquire()
+		if err != nil {
+			reply(429, "busy")
+			return
+		}
+		if conn == nil {
+			reply(503, "unhealthy")
+			return
+		}
+		ctx, cancel := context.WithTimeout(r.Context(), 1500*time.Millisecond)
+		defer cancel()
+		ctx = mcpclient.ContextWithResponseDeadlineEnforcement(ctx)
+		id, _ := jsonrpc.MakeID("nava-health-" + uuid.NewString())
+		// lnwjud's stdio server is modern-only. Probe with a real lightweight
+		// MCP tool call and the required 2026 envelope instead of JSON-RPC ping,
+		// which this server does not expose as a method.
+		params := json.RawMessage(`{"_meta":{"io.modelcontextprotocol/protocolVersion":"2026-07-28","io.modelcontextprotocol/clientCapabilities":{}},"name":"mcp_health","arguments":{}}`)
+		_, err = conn.Write(ctx, nil, &jsonrpc.Request{ID: id, Method: "tools/call", Params: params})
+		if err == nil {
+			for {
+				msg, readErr := conn.Read(ctx)
+				if readErr != nil {
+					err = readErr
+					break
+				}
+				if response, ok := msg.(*jsonrpc.Response); ok {
+					if response.ID == id && response.Error == nil {
+						reply(200, "live")
+						return
+					}
+					break
+				}
+			}
+		}
+		// Retire a timed-out probe without destroying process-affine pipes.
+		if retirement, ok := conn.(mcpclient.ResponseDeadlineRetiringConnection); ok {
+			retirement.RetireResponseDeadline()
+		}
+		reply(503, "unhealthy")
+	})
+}
