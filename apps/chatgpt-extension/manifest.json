{
  "manifest_version": 3,
  "name": "NAVA Command Room Wake",
  "version": "0.1.0",
  "description": "Opt-in, fail-closed wake notifications for one bound ChatGPT conversation.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "NAVA Command Room",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
